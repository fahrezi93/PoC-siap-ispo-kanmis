APP_NAME="Aplikasi B"
APP_URL=http://localhost:8001
APP_KEY=
DB_CONNECTION=sqlsrv
DB_HOST=localhost\SQLEXPRESS
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true
DB_DATABASE=db_keuangan_b
API_GATEWAY_KEY=
FINANCE_PUBLISHER_ENABLED=true
FINANCE_CLONE_ENABLED=false
FINANCE_CLONE_TRANSPORT=network
FINANCE_CLONE_SOURCE_DATABASE=db_toko_a
FINANCE_CLONE_SOURCE_SERVER=192.168.10.10,1433
FINANCE_CLONE_SOURCE_USERNAME=
FINANCE_CLONE_SOURCE_PASSWORD=
FINANCE_CLONE_SOURCE_TRUST_CERTIFICATE=false
# Path di server SQL A, bukan path laptop C.
FINANCE_CLONE_SOURCE_BACKUP_PATH='D:\SqlBackups\toko_a_for_b.bak'
# File yang sama di A, dibaca akun Windows scheduler B melalui SMB.
FINANCE_CLONE_TRANSFER_SOURCE='\\SERVER-A\CloneBackup\toko_a_for_b.bak'
# Path yang dapat ditulis proses scheduler B.
FINANCE_CLONE_TRANSFER_DESTINATION='D:\Inbound\toko_a_for_b.bak'
# File hasil transfer yang sama, dilihat dari server SQL B.
FINANCE_CLONE_TARGET_BACKUP_PATH='D:\Inbound\toko_a_for_b.bak'
FINANCE_SOURCE_CONNECTION=sqlsrv
FINANCE_PAGE_SIZE=500
FINANCE_SNAPSHOT_HOURS=24
APP_ENV=local
APP_DEBUG=true
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta
LOG_CHANNEL=stack
LOG_LEVEL=debug
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FINANCE_LOCK_STORE=file
